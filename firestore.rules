rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner data: tasks and buckets — fully isolated per user
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Contributor read exception: lets a contributor read a single task they submitted
      allow read: if request.auth != null && resource.data.contributorUID == request.auth.uid;
    }

    match /users/{userId}/buckets/{bucketId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Inbox: contributor can create and read/delete their own submissions; owner has full access
    match /users/{userId}/inbox/{inboxId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.resource.data.contributorUID == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.contributorUID == request.auth.uid;
    }

    // FCM tokens: user reads/writes their own tokens only
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notification preferences: owner read/write only
    match /users/{userId}/notificationPrefs {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reminders: owner read/write only — read by the onReminderDue scheduled
    // function via the Admin SDK, which bypasses these rules.
    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contributor permissions: contributor reads/writes their own document only
    match /users/{userId}/permissions/contributor {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite codes.
    // - create: only the owner may mint an invite, and only for their own UID.
    // - get: any authenticated user may read a SINGLE invite *if they know the
    //   exact code* (the doc ID). `list` is intentionally NOT granted, so the
    //   collection cannot be enumerated — this prevents harvesting every user's
    //   ownerEmail/ownerUID and every outstanding code.
    // - update: the owner may edit their own invite; a contributor may redeem an
    //   un-redeemed invite by stamping redeemedBy with their own UID (and may not
    //   alter ownerUID in the process).
    match /invites/{code} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUID == request.auth.uid;
      allow get: if request.auth != null;
      allow update: if request.auth != null
                    && (
                      resource.data.ownerUID == request.auth.uid
                      || (
                        resource.data.get('redeemedBy', null) == null
                        && request.resource.data.redeemedBy == request.auth.uid
                        && request.resource.data.ownerUID == resource.data.ownerUID
                      )
                    );
    }
  }
}
